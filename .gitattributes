# Default: auto-detect text. Per-extension rules below take precedence.
* text=auto

# Source that the TS toolchain and generators write with LF
*.ts text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.glsl text eol=lf

# Unreal and Windows tooling expect CRLF
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.ini text eol=crlf
*.cfg text eol=crlf
*.txt text eol=crlf
*.csv text eol=crlf
*.tsv text eol=crlf
*.xml text eol=crlf
*.usf text eol=crlf
*.ush text eol=crlf
*.hlsl text eol=crlf
*.uproject text eol=crlf
*.uplugin text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unreal assets live in LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Generated and log files: don't diff or merge
*.generated.h -diff -merge
*.generated.cpp -diff -merge
*.uhtmanifest -diff -merge
*.deps -diff -merge
*.log -diff -merge -text


{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.db-lyon/ue-mcp",
  "title": "UE-MCP",
  "description": "Unreal Engine MCP server - 32 tools, 3747+ actions for AI-driven editor control",
  "version": "1.4.16-beta.3",
  "websiteUrl": "https://ue-mcp.com",
  "repository": {
    "url": "https://github.com/db-lyon/ue-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "ue-mcp",
      "version": "1.4.16-beta.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "uproject",
          "description": "Absolute path to a .uproject file or its directory. Pass several for several editors; omit it and attach one later with project(set_project).",
          "format": "filepath",
          "isRequired": false,
          "isRepeated": true
        }
      ]
    }
  ]
}

{
  "name": "ue-mcp",
  "version": "1.3.8",
  "description": "Unreal Engine MCP server - 26 tools, 1930+ actions for AI-driven editor control",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./task": {
      "types": "./dist/task.d.ts",
      "default": "./dist/task.js"
    },
    "./guard": {
      "types": "./dist/guard-task.d.ts",
      "default": "./dist/guard-task.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ue-mcp": "dist/index.js",
    "ue-mcp-init": "dist/init.js",
    "ue-mcp-update": "dist/update.js",
    "ue-mcp-deploy": "dist/deploy-cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "skills",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "unreal-engine",
    "mcp",
    "model-context-protocol",
    "ai",
    "game-development",
    "editor",
    "blueprint",
    "ue5"
  ],
  "author": "David Lyon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/db-lyon/ue-mcp.git"
  },
  "homepage": "https://ue-mcp.com/docs/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "node scripts/run.js",
    "build": "node scripts/build.js",
    "up:build": "node scripts/build-and-run.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:multi-editor": "vitest run tests/multi-editor",
    "test:live": "node scripts/live-tests.mjs",
    "golden:record": "node scripts/record-golden.mjs",
    "release:notes": "node scripts/compose-release-notes.mjs",
    "audit:docs": "node scripts/audit-docs.mjs && node scripts/audit-params.mjs",
    "audit:handlers": "node scripts/audit-handlers.mjs",
    "lint:prose": "node scripts/lint-prose.mjs",
    "check:config": "node scripts/check-tracked-config.mjs",
    "check:flows": "node scripts/check-flows.mjs",
    "check:release": "node scripts/check-release-gates.mjs all",
    "audit:unity": "node scripts/audit-unity-collisions.mjs",
    "audit": "npm run audit:docs && npm run audit:handlers && npm run lint:prose && npm run check:config && npm run check:flows && npm run audit:unity",
    "test:watch": "vitest",
    "test:level": "vitest run tests/smoke/level.test.ts",
    "test:asset": "vitest run tests/smoke/asset.test.ts",
    "test:blueprint": "vitest run tests/smoke/blueprint.test.ts",
    "test:material": "vitest run tests/smoke/material.test.ts",
    "test:editor": "vitest run tests/smoke/editor.test.ts",
    "test:reflection": "vitest run tests/smoke/reflection.test.ts",
    "test:animation": "vitest run tests/smoke/animation.test.ts",
    "test:landscape": "vitest run tests/smoke/landscape.test.ts",
    "test:gameplay": "vitest run tests/smoke/gameplay.test.ts",
    "test:audio": "vitest run tests/smoke/audio.test.ts",
    "test:niagara": "vitest run tests/smoke/niagara.test.ts",
    "test:pcg": "vitest run tests/smoke/pcg.test.ts",
    "test:foliage": "vitest run tests/smoke/foliage.test.ts",
    "test:widget": "vitest run tests/smoke/widget.test.ts",
    "test:networking": "vitest run tests/smoke/networking.test.ts",
    "test:gas": "vitest run tests/smoke/gas.test.ts",
    "test:smoke": "node scripts/smoke-test.js",
    "context-tax": "node scripts/context-tax.mjs",
    "generate": "tsx scripts/generate-default-config.ts",
    "generate:metadata": "tsx scripts/generate-tool-metadata.ts",
    "prepublishOnly": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npx tsc && tsx scripts/generate-default-config.ts && tsx scripts/generate-tool-metadata.ts",
    "gen:epic-docs": "npx tsc && node scripts/gen-epic-docs.mjs",
    "prepare": "husky",
    "epic:record": "node scripts/record-epic-catalog.mjs",
    "epic:generate": "node scripts/generate-epic-actions.mjs",
    "epic:seed": "node scripts/seed-epic-effects.mjs",
    "epic:unreviewed": "node scripts/epic-unreviewed.mjs"
  },
  "dependencies": {
    "@db-lyon/flowkit": "^0.17.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "js-yaml": "^4.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}

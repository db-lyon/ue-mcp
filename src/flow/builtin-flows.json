      "4": {"task":"level.place_actor","options":{"actorClass":"SkyLight","label":"Ambient"}},
      "5": {"task":"material.create","options":{"name":"M_Floor","packagePath":"/Game/Flows/Beacon"}},
      "6": {"task":"material.set_base_color","options":{"assetPath":"/Game/Flows/Beacon/M_Floor","color":{"r":15,"g":15,"b":18}}},

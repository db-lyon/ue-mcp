{
  "blockout_to_assets": {
    "description": "Replace every blockout actor carrying tag (default Blockout) with the best-fitting StaticMesh under candidateFolder: lists the set, ranks the candidates by bounds, swaps each actor for its best match fitted to its bounds (fit, default uniform), then lists the replacements. Each replacement keeps a record, so level(restore_blockout) or the run's rollback puts the blockout back.",
    "steps": {
      "1": {"task":"level.list_blockout"},
      "2": {"task":"level.match_asset_to_blockout","options":{"tag":"Blockout"}},
      "3": {"task":"level.replace_blockout","options":{"tag":"Blockout"}},
      "4": {"task":"level.list_blockout","options":{"includeReplaced":true}}
    }
  },
  "niagara_fire": {
    "description": "Build a fire Niagara system from scratch (spawn rate, upward velocity, HDR orange colour) and verify it emits. A 0-to-1 best-practice starting point, not a demo. Lands at /Game/VFX/Fire/NS_Fire; override name/packagePath via params.",
    "steps": {
      "1": {"task":"niagara.create_emitter","options":{"name":"E_Flame","packagePath":"/Game/VFX/Fire"}},
      "2": {"task":"niagara.create","options":{"name":"NS_Fire","packagePath":"/Game/VFX/Fire"}},
      "3": {"task":"niagara.add_emitter","options":{"systemPath":"${steps.2.path}","emitterPath":"${steps.1.path}"}},
      "4": {"task":"niagara.set_module_input","options":{"systemPath":"${steps.2.path}","moduleName":"SpawnRate","inputName":"SpawnRate","value":"60","stackContext":"EmitterUpdate"}},
      "5": {"task":"niagara.set_module_input","options":{"systemPath":"${steps.2.path}","moduleName":"AddVelocity","inputName":"Velocity","value":"0,0,160","stackContext":"ParticleSpawn"}},
      "6": {"task":"niagara.set_module_input","options":{"systemPath":"${steps.2.path}","moduleName":"Color","inputName":"Color","value":"4.0,1.2,0.15,1.0","stackContext":"ParticleUpdate"}},
      "7": {"task":"niagara.validate","options":{"systemPath":"${steps.2.path}"}}
    }
  },
  "beacon": {
    "description": "Demo - build a shrine scene from scratch: floor, pedestal, orb, five pillars, four materials (dark stone, brushed metal, warm stone, parameterized emissive), colored lights, and atmosphere",
    "steps": {
      "1": {"task":"level.create","options":{"levelPath":"/Game/Flows/Beacon/BeaconLevel"}},
      "2": {"task":"level.place_actor","options":{"actorClass":"SkyAtmosphere","label":"Sky"}},

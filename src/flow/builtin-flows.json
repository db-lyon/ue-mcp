      "20": {"task":"material.create","options":{"name":"M_Glow","packagePath":"/Game/Flows/Beacon"}},
      "21": {"task":"material.add_expression","options":{"materialPath":"/Game/Flows/Beacon/M_Glow","expressionType":"VectorParameter","name":"GlowColor","parameterName":"GlowColor"}},
      "22": {"task":"material.add_expression","options":{"materialPath":"/Game/Flows/Beacon/M_Glow","expressionType":"Constant","name":"GlowStrength"}},

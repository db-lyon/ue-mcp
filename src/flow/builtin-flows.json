      "10": {"task":"material.add_expression","options":{"materialPath":"/Game/Flows/Beacon/M_Pillar","expressionType":"Constant","name":"Metallic"}},
      "11": {"task":"material.set_expression_value","options":{"materialPath":"/Game/Flows/Beacon/M_Pillar","expressionIndex":"${steps.10.expressionIndex}","value":1}},
      "12": {"task":"material.connect_to_property","options":{"materialPath":"/Game/Flows/Beacon/M_Pillar","expressionName":"Metallic","property":"Metallic"}},
